#-----------------------------------------

if "contiene" in texto.lower():

    partes = re.split(
        r"contiene",
        texto,
        flags=re.IGNORECASE
    )

    c = partes[0].strip()

    valor = partes[1].strip()

    r = obtener(c)


    if r is None:
        return False

    if isinstance(r,list):

        return any(
            valor.lower() in str(x).lower()
            for x in r
        )

    return valor.lower() in str(r).lower()

#-----------------------------------------
# C incluye xxx
