import numpy as np

def calcular\_total\_cotizacion(productos\_seleccionados):
total = 0
if not productos\_seleccionados:
return 0

```
for producto in productos_seleccionados:
    # Check if the price is a valid number and not NaN
    if isinstance(producto['precio'], (int, float)) and not np.isnan(producto['precio']):
        total += producto['precio']
    else:
        # Treat NaN prices as 0 for calculation, but print a warning
        if np.isnan(producto['precio']):
            print(f"Advertencia: El producto '{producto['nombre']}' tiene un precio no válido (NaN) y se considerará 0 en el cálculo.")
        else:
            print(f"Advertencia: El producto '{producto['nombre']}' tiene un precio no válido '{producto['precio']}' y será omitido del cálculo.")
return total
```

